generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // строка подключения из файла .env
}

// Роли пользователей: ADMIN и MANAGER — доступ в /admin, USER — обычный клиент
enum Role {
  ADMIN
  MANAGER
  USER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

// Аккаунты: вход на сайт, кабинет, привязка записей и отзывов
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  phone         String?
  image         String?
  role          Role      @default(USER)
  favorites     Favorite[]
  bookings      Booking[]
  reviews       Review[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([role])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Мастера студии — страницы /master/[slug], выбор при записи
model TattooArtist {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  bio         String?      @db.Text
  styles      String[]
  photoUrl    String?
  experience  Int?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  works       TattooWork[]
  bookings    Booking[]
  reviews     Review[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model Category {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  sortOrder   Int          @default(0)
  works       TattooWork[]
  gallery     GalleryItem[]
  blogPosts   BlogPost[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([sortOrder])
}

// Эскизы в каталоге /eskizy — картинка в imageUrl (путь из public/images)
model TattooWork {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  style       String?
  priceFrom   Int?
  imageUrl    String
  isFeatured  Boolean       @default(false)
  isPublished Boolean       @default(true)
  sortOrder   Int           @default(0)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  artistId    String?
  artist      TattooArtist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  favorites   Favorite[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([isPublished, isFeatured])
  @@index([categoryId])
  @@index([artistId])
  @@index([deletedAt])
}

// Избранные эскизы (сердечко в каталоге) — связь пользователь + эскиз
model Favorite {
  id        String     @id @default(cuid())
  userId    String
  workId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      TattooWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, workId])
}

// Заявки на запись с /zapis — видны в кабинете и в /admin/bookings
model Booking {
  id          String        @id @default(cuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  artistId    String?
  artist      TattooArtist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  clientName  String
  clientEmail String
  clientPhone String
  idea        String?       @db.Text
  date        DateTime
  timeSlot    String
  status      BookingStatus @default(PENDING)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([date])
  @@index([artistId])
}

// Отзывы клиентов. isPublished=false — на модерации, true — виден на сайте
model Review {
  id        String        @id @default(cuid())
  author    String          // имя для отображения (из профиля или вручную в админке)
  content   String        @db.Text
  rating    Int           @default(5)
  isPublished Boolean     @default(false) // false = ждёт проверки админом
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  artistId  String?
  artist    TattooArtist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([isPublished])
  @@index([artistId])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String    @db.Text
  coverUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([isPublished, publishedAt])
  @@index([categoryId])
}

model GalleryItem {
  id          String    @id @default(cuid())
  title       String?
  imageUrl    String
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([isPublished, sortOrder])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

// Одна строка настроек сайта: телефон, адрес, соцсети (редактируется в /admin/settings)
model SiteSettings {
  id              String   @id @default("default")
  siteName        String   @default("INK / STUDIO")
  tagline         String   @default("Авторская татуировка. С 2014.")
  address         String   @default("ул. Никольская 12, Москва")
  phone           String   @default("+7 (495) 000-00-00")
  email           String   @default("hello@inkstudio.ru")
  workingHours    String   @default("Ежедневно 12:00 – 22:00")
  telegramBotToken String?
  telegramChatId  String?
  mapEmbedUrl     String?
  socialInstagram String?
  socialTelegram  String?
  socialVk        String?
  cookieConsentText String? @db.Text
  analyticsId     String?
  updatedAt       DateTime @updatedAt
}
